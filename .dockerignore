# Allowlist: the build context contains ONLY the entries re-included below.
# The image is public, so anything not required by `npm ci` + `next build` stays out
# (env files, git metadata, docs, local artifacts).
*

!package.json
!package-lock.json
!next.config.ts
!tsconfig.json
!postcss.config.mjs
!src/
!public/

# Never send env files or local build output, even from inside allowed directories.
**/.env
**/.env.*
**/node_modules
**/.next
