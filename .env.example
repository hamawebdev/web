# Med-ADN web - environment variables
# Copy to .env.local for local development. Never commit real .env files.
#
# All NEXT_PUBLIC_* values are PUBLIC: they are baked into the browser bundle at
# build time (Docker build args in CI). Do not put secrets in them.

# Backend REST API base URL (the browser calls it directly).
NEXT_PUBLIC_API_URL=https://api.med-adn.com/api/v1
# Local backend example:
# NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Public URL of this web app (canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_APP_URL=https://med-adn.com

# Display name.
NEXT_PUBLIC_APP_NAME=Med-ADN

# Optional: set to "true" to never send cookies to a localhost backend.
# NEXT_PUBLIC_DISABLE_CREDENTIALS=true

# Runtime only (set by the Docker image): commit reported by GET /api/health.
# GIT_SHA=unknown
